# HTTP_PORT / HTTP_PORT_NAIVE map container port 8080 to the host (compose only).
# HTTP_ADDR is the bind address used inside the container.
HTTP_ADDR=:8080
HTTP_PORT=8080
HTTP_PORT_NAIVE=8081

POSTGRES_USER=webhook
POSTGRES_PASSWORD=webhook
POSTGRES_DB=webhook_guard
POSTGRES_PORT=5432

DATABASE_URL=postgres://webhook:webhook@localhost:5432/webhook_guard?sslmode=disable

WEBHOOK_SIGNING_SECRET=whsec_dev_change_me
SIGNATURE_TOLERANCE=5m

# River queue this binary consumes. app uses WORKER_QUEUE (default) and
# app-naive uses WORKER_QUEUE_NAIVE so both workers never share a queue.
WORKER_QUEUE=default
WORKER_QUEUE_NAIVE=naive

# Read-only dashboard (Caddy + Astro). DEMO_MODE enables the gated demo
# endpoint that sends signed sample webhooks from the UI; keep it false.
DASHBOARD_PORT=4321
DEMO_MODE=false

# Gated write path for the live guarded-vs-naive comparison. Keep it false:
# when true, POST /api/v1/loadgen/runs accepts a loadgen result (same-origin,
# JSON, validated) so the /compare page can show a real run.
LOADGEN_INGEST=false

# Frontend dev only: Astro proxies /api here. Uncomment to override.
# API_PROXY_TARGET=http://localhost:8080

LOG_LEVEL=info
LOG_FORMAT=json

LOADGEN_TARGET=http://app:8080
LOADGEN_WEBHOOK_SECRET=whsec_dev_change_me
LOADGEN_MODE=normal
LOADGEN_EVENTS=100
LOADGEN_CONCURRENCY=10
LOADGEN_SEED=1
LOADGEN_FORMAT=text
# Label reported to the ingest endpoint (guarded|naive) and the optional URL
# that receives the result, e.g. http://app:8080/api/v1/loadgen/runs.
LOADGEN_ROUTE=guarded
LOADGEN_RESULT_URL=
