---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Read-only observability for the webhook-guard idempotent ledger.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='3' fill='%230f1415'/%3E%3Crect x='6' y='7' width='20' height='7' rx='1' fill='%23e9dfc8'/%3E%3Crect x='6' y='18' width='20' height='7' rx='1' fill='%23e9dfc8'/%3E%3Crect x='9' y='10' width='3' height='1.5' fill='%23e0a63a'/%3E%3Crect x='9' y='21' width='3' height='1.5' fill='%23e0a63a'/%3E%3C/svg%3E"
    />
    <title>{title} · webhook-guard</title>
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content · Saltar al contenido</a>
    <noscript>
      <div class="page">
        <div class="card">
          <div class="card-body stack">
            <p class="card-title">JavaScript is required</p>
            <p class="empty-body">
              The dashboard reads the ledger through the JSON API in the browser. Enable JavaScript
              to inspect events, charges and reconciliation reports.
            </p>
            <p class="empty-body" lang="es">
              El dashboard lee el ledger mediante la API JSON en el navegador. Activa JavaScript para
              inspeccionar eventos, cargos y reportes de reconciliación.
            </p>
          </div>
        </div>
      </div>
    </noscript>
    <slot />
  </body>
</html>
