---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.svelte";
import LateEventsPage from "../components/LateEventsPage.svelte";
---

<Base title="Late events">
  <div class="app-shell">
    <Nav client:load initialPath={Astro.url.pathname} />
    <main id="main" class="page">
      <LateEventsPage client:load />
    </main>
  </div>
</Base>
